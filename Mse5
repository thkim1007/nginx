OpenCV C++의 ⁠getGaussianKernel⁠ 및 ⁠sepFilter2D⁠ 내부 로직과 똑같이 커널을 16비트 정수(Scale Factor 2^{16} = 65536)로 변환하고 비트 연산 기반의 반올림(⁠+ 32768 >> 16⁠)을 적용하면 Java 값이 1~2 크게 나오는 현상이 완전히 사라집니다.

public class OpenCVExactGaussianBlur {

    private static final int KERNEL_SHIFT = 16;
    private static final int KERNEL_SCALE = 1 << KERNEL_SHIFT; // 65536

    // OpenCV 스타일 고정소수점(Fixed-Point) 1D 커널 생성
    public static int[] getFixedPointKernel(int ksize, double sigma) {
        if (sigma <= 0) {
            sigma = 0.3 * ((ksize - 1) * 0.5 - 1) + 0.8;
        }

        double[] doubleKernel = new double[ksize];
        double sum = 0.0;
        int center = ksize / 2;

        for (int i = 0; i < ksize; i++) {
            int x = i - center;
            doubleKernel[i] = Math.exp(-(x * x) / (2.0 * sigma * sigma));
            sum += doubleKernel[i];
        }

        // OpenCV C++ 연산 동일: 65536을 곱한 후 정수로 변환 (cvRound 방식)
        int[] intKernel = new int[ksize];
        int intSum = 0;
        for (int i = 0; i < ksize; i++) {
            intKernel[i] = (int) Math.round((doubleKernel[i] / sum) * KERNEL_SCALE);
            intSum += intKernel[i];
        }
        
        // 정수 변환 오차 보정 (합이 정확히 65536이 되도록 중심값에 차이 더함)
        intKernel[center] += (KERNEL_SCALE - intSum);

        return intKernel;
    }

    private static int reflect101(int p, int length) {
        if (length == 1) return 0;
        if (p < 0) return -p;
        if (p >= length) return 2 * length - 2 - p;
        return p;
    }

    public static int[][] gaussianBlur(int[][] image, int ksize, double sigma) {
        int height = image.length;
        int width = image[0].length;
        int[] kernel = getFixedPointKernel(ksize, sigma);
        int radius = ksize / 2;

        // 1단계: 가로 방향 정수 연산
        int[][] temp = new int[height][width];
        for (int y = 0; y < height; y++) {
            for (int x = 0; x < width; x++) {
                int sum = 0;
                for (int k = -radius; k <= radius; k++) {
                    int ix = reflect101(x + k, width);
                    sum += image[y][ix] * kernel[k + radius];
                }
                // OpenCV fast round 적용 (비트 시프트)
                temp[y][x] = (sum + (1 << (KERNEL_SHIFT - 1))) >> KERNEL_SHIFT;
            }
        }

        // 2단계: 세로 방향 정수 연산
        int[][] result = new int[height][width];
        for (int y = 0; y < height; y++) {
            for (int x = 0; x < width; x++) {
                int sum = 0;
                for (int k = -radius; k <= radius; k++) {
                    int iy = reflect101(y + k, height);
                    sum += temp[iy][x] * kernel[k + radius];
                }
                
                int val = (sum + (1 << (KERNEL_SHIFT - 1))) >> KERNEL_SHIFT;
                
                // 0 ~ 255 Clamping
                result[y][x] = Math.min(255, Math.max(0, val));
            }
        }

        return result;
    }
}
