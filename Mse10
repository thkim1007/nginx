public class OpenCVTrueReplicaBlur {

    // OpenCV C++ CV_8U 처리 전용 8비트 Shift (2^8 = 256)
    private static final int SHIFT = 8;
    private static final int SCALE = 1 << SHIFT; // 256

    /**
     * OpenCV C++ getGaussianKernel (fixed-point for CV_8U) 완벽 복제
     */
    public static int[] getOpenCV8UKernel(int ksize, double sigma) {
        if (sigma <= 0) {
            // C++ 내부 float 캐스팅 정밀도 유지
            sigma = (float)(0.3f * ((ksize - 1) * 0.5f - 1.0f) + 0.8f);
        }

        double[] doubleKernel = new double[ksize];
        double sum = 0.0;
        int center = ksize / 2;

        for (int i = 0; i < ksize; i++) {
            int x = i - center;
            doubleKernel[i] = Math.exp(-(x * x) / (2.0 * sigma * sigma));
            sum += doubleKernel[i];
        }

        // 256 스케일 정수 변환
        int[] intKernel = new int[ksize];
        int intSum = 0;
        for (int i = 0; i < ksize; i++) {
            // cvRound 동작
            intKernel[i] = (int) Math.round((doubleKernel[i] / sum) * SCALE);
            intSum += intKernel[i];
        }

        // OpenCV C++ 오차 보정 (합이 정확히 256이 되도록 중심점 보정)
        int diff = SCALE - intSum;
        intKernel[center] += diff;

        return intKernel;
    }

    private static int reflect101(int p, int length) {
        if (length == 1) return 0;
        if (p < 0) return -p;
        if (p >= length) return 2 * length - 2 - p;
        return p;
    }

    /**
     * Python cv2.GaussianBlur(CV_8U)와 비트 단위 일치 처리
     */
    public static int[][] gaussianBlur(int[][] image, int ksize, double sigma) {
        int height = image.length;
        int width = image[0].length;
        int[] kernel = getOpenCV8UKernel(ksize, sigma);
        int radius = ksize / 2;

        // 1단계: Horizontal 패스 (256 스케일 연산 후 >> 8 절삭)
        int[][] temp = new int[height][width];
        for (int y = 0; y < height; y++) {
            for (int x = 0; x < width; x++) {
                int sum = 0;
                for (int k = -radius; k <= radius; k++) {
                    int ix = reflect101(x + k, width);
                    sum += image[y][ix] * kernel[k + radius];
                }
                // OpenCV C++: (sum + 128) >> 8
                int val = (sum + (1 << (SHIFT - 1))) >> SHIFT;
                
                // 1차 saturate_cast<uchar>
                if (val > 255) val = 255;
                if (val < 0) val = 0;
                temp[y][x] = val;
            }
        }

        // 2단계: Vertical 패스 (256 스케일 연산 후 >> 8 절삭 및 최종 saturate_cast)
        int[][] result = new int[height][width];
        for (int y = 0; y < height; y++) {
            for (int x = 0; x < width; x++) {
                int sum = 0;
                for (int k = -radius; k <= radius; k++) {
                    int iy = reflect101(y + k, height);
                    sum += temp[iy][x] * kernel[k + radius];
                }
                
                // OpenCV C++: (sum + 128) >> 8
                int val = (sum + (1 << (SHIFT - 1))) >> SHIFT;

                // 2차 saturate_cast<uchar>
                if (val > 255) val = 255;
                if (val < 0) val = 0;
                
                result[y][x] = val;
            }
        }

        return result;
    }
}
