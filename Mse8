// Java의 픽셀 수치가 Python보다 미세하게 낮게/높게 판단되는 현상을 보정
public static int applyThresholdWithTolerance(double blurredPixel, double threshold) {
    // 부동소수점 연산 경계값 오차(159.5~160.0)를 160 이상으로 인정
    double tolerance = 0.5; 
    
    if (blurredPixel + tolerance >= threshold) {
        return 255;
    } else {
        return 0;
    }
}
