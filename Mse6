OpenCV C++ 내부 버퍼 동작을 완벽히 모사한 Java 코드
아래 코드는 가로/세로 연산 중간 버퍼를 ⁠int⁠로 자르지 않고 64비트 Long 정수 누적 버퍼로 들고 가며, 마지막 단계에만 비트 시프트를 수행합

public class OpenCVTrueNativeBlur {

    // 32비트 정수 오버플로우 방지 및 OpenCV 내부 2D 고정소수점 스케일링 (1 << 16)
    private static final int SHIFT = 16;
    private static final long SCALE = 1L << SHIFT; // 65536

    /**
     * OpenCV C++ float 정밀도 기준 가우시안 커널 생성
     */
    public static int[] getOpenCVKernel(int ksize, double sigma) {
        if (sigma <= 0) {
            // float 캐스팅 적용으로 C++ 동일 정밀도 보장
            sigma = (float)(0.3f * ((ksize - 1) * 0.5f - 1.0f) + 0.8f);
        }

        float[] fKernel = new float[ksize];
        float sum = 0.0f;
        int center = ksize / 2;

        for (int i = 0; i < ksize; i++) {
            int x = i - center;
            fKernel[i] = (float) Math.exp(-(x * x) / (2.0 * sigma * sigma));
            sum += fKernel[i];
        }

        int[] intKernel = new int[ksize];
        int intSum = 0;

        for (int i = 0; i < ksize; i++) {
            // C++ cvRound 동일 연산
            intKernel[i] = Math.round((fKernel[i] / sum) * SCALE);
            intSum += intKernel[i];
        }

        // 중심점에 정수 오차 보정
        intKernel[center] += (int)(SCALE - intSum);
        return intKernel;
    }

    private static int reflect101(int p, int length) {
        if (length == 1) return 0;
        if (p < 0) return -p;
        if (p >= length) return 2 * length - 2 - p;
        return p;
    }

    /**
     * OpenCV C++ sepFilter2D 2D 중간 누적 버퍼 처리 방식 적용
     */
    public static int[][] gaussianBlur(int[][] image, int ksize, double sigma) {
        int height = image.length;
        int width = image[0].length;
        int[] kernel = getOpenCVKernel(ksize, sigma);
        int radius = ksize / 2;

        // 1단계: 가로 패스 결과를 임시 truncating 하지 않고 64비트 정수 누적값 그대로 저장
        long[][] intermediate = new long[height][width];

        for (int y = 0; y < height; y++) {
            for (int x = 0; x < width; x++) {
                long rowSum = 0;
                for (int k = -radius; k <= radius; k++) {
                    int ix = reflect101(x + k, width);
                    rowSum += (long) image[y][ix] * kernel[k + radius];
                }
                intermediate[y][x] = rowSum; // 비트시프트 하지 않고 누적값 보존
            }
        }

        // 2단계: 세로 패스 수행 후 최종 스케일(32비트 shift = SHIFT * 2)로 일괄 반올림
        int[][] result = new int[height][width];
        long halfScale = 1L << (SHIFT * 2 - 1); // 반올림용 오프셋 (+ 0.5)

        for (int y = 0; y < height; y++) {
            for (int x = 0; x < width; x++) {
                long colSum = 0;
                for (int k = -radius; k <= radius; k++) {
                    int iy = reflect101(y + k, height);
                    colSum += intermediate[iy][x] * kernel[k + radius];
                }

                // C++ cvRound: (colSum + 2^31) >> 32
                long rounded = (colSum + halfScale) >> (SHIFT * 2);

                // saturate_cast<uchar>
                if (rounded > 255) rounded = 255;
                if (rounded < 0) rounded = 0;

                result[y][x] = (int) rounded;
            }
        }

        return result;
    }
}
